{
  "name": "weather-mcp-ph",
  "version": "0.1.0",
  "description": "Philippines-focused MCP weather server using PAGASA, Open-Meteo, NASA GIBS/FIRMS, RainViewer, and Blitzortung.",
  "mcpName": "io.github.tomohiro-owada/weather-mcp-ph",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "weather-mcp-ph": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "audit": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "weather",
    "weather-api",
    "weather-forecast",
    "pagasa",
    "philippines",
    "open-meteo",
    "forecast",
    "climate",
    "historical-weather",
    "weather-alerts",
    "air-quality",
    "marine-weather",
    "lightning",
    "weather-radar",
    "wildfire",
    "geocoding",
    "free",
    "claude",
    "claude-code",
    "cursor",
    "ai",
    "llm",
    "ai-tools"
  ],
  "author": "Tomohiro Owada; based on Weather MCP by Dan Gahagan",
  "license": "MIT",
  "homepage": "https://github.com/tomohiro-owada/weather-mcp-ph#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomohiro-owada/weather-mcp-ph.git"
  },
  "bugs": {
    "url": "https://github.com/tomohiro-owada/weather-mcp-ph/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.21.1",
    "axios": "^1.13.1",
    "dotenv": "^17.2.3",
    "fast-xml-parser": "^5.10.1",
    "luxon": "^3.7.2",
    "mqtt": "^5.14.1",
    "ngeohash": "^0.6.3",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/ngeohash": "^0.6.8",
    "@types/node": "^26.1.1",
    "@types/tz-lookup": "^6.1.2",
    "@vitest/coverage-v8": "^4.0.8",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.0.8"
  }
}
