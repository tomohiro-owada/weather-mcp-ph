# Exposed tools: basic (default), standard, full, or a comma-separated list.
ENABLED_TOOLS=basic

# Philippines-friendly defaults.
WEATHER_UNITS=metric

# Transport: stdio (default) or http/streamable-http.
# MCP_TRANSPORT=http
# MCP_HOST=127.0.0.1
# PORT=3000
# MCP_PATH=/mcp

# Required when HTTP binds to a non-loopback address. Generate with:
# openssl rand -hex 32
# MCP_AUTH_TOKEN=
# MCP_ALLOWED_HOSTS=weather.example.com
# MCP_MAX_SESSIONS=100
# MCP_SESSION_TTL_MS=3600000

# Optional NASA FIRMS key for get_wildfire_info.
# FIRMS_MAP_KEY=

# Lightning uses a public community MQTT broker by default.
# BLITZORTUNG_MQTT_URL=mqtt://blitzortung.ha.sed.pl:1883
WEATHER_LIGHTNING_PREWARM=true

# Logging and opt-in analytics.
LOG_LEVEL=INFO
ANALYTICS_ENABLED=false
